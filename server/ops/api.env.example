# /etc/doedesk/api.env: every setting of the API. Owned by root, mode 600. systemd reads it and
# hands the values to the service; nothing else needs to open it. docs/variables.md says what each
# one does and where its value comes from. Lines starting with # are not set.
#
# Values may be quoted with single quotes. Never commit a filled copy of this file.

# --- Required -----------------------------------------------------------------------------------
DOEDESK_ENV=production
# ES256 private key as a JWK, the same one the Worker used (so tokens keep verifying).
JWT_PRIVATE_JWK=
# Opens the owner's dashboard. At least 24 characters.
ADMIN_KEY=
# SMS codes (Authentica).
AUTHENTICA_API_KEY=
# Sign-in emails: Oracle Email Delivery in Jeddah.
SMTP_HOST=smtp.email.me-jeddah-1.oci.oraclecloud.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Detection and reading: the engine on this machine --------------------------------------------
# Required. Every text and file sent for detection or reading goes here and nowhere else.
ENGINE_URL=http://127.0.0.1:8080
#ENGINE_TOKEN=
# Optional, for the owner's dashboard only: what the engine costs, in US dollars. Unset: no cost shown.
#ENGINE_PRICE_PER_1000_UNITS=
#ENGINE_PRICE_PER_1000_PAGES=

# --- Optional: the worker that reads sealed documents, one upstream per account region ---------------
# A request goes to the upstream of the account's region and to no other. A region without a key
# answers that its worker is not available; it is never answered for by another region.
# A key opens the worker only to accounts an operator switched on (docs/runbook.md); every other
# account is refused before its request is read.
# Defaults shown: each region's model and how it is asked are the ones the evaluation measured,
# so a region needs only its key. See docs/variables.md for the other settings (STRUCTURED,
# REASONING_EFFORT, MIN_OUTPUT_TOKENS, PROVIDER, EXPECTED_PROVIDER, EXPECTED_DATA_REGION,
# MAX_WAIT_SECONDS, MAX_WAITING, HOSTED_IN).
# Saudi Arabia: deep.sa, which says its Saudi-hosted models run in the Kingdom. The region is
# served only while deep.sa's own list of models marks this model `hosted_in: saudi`.
# PARALLEL and PER_MINUTE are what the deep.sa plan allows, for all accounts together: 1 and 60
# on the smallest plan, 5 and 300 on the next. Keep PER_MINUTE a little under the plan's.
#WORKER_SA_API_KEY=
#WORKER_SA_URL=https://alapi.deep.sa/v1
#WORKER_SA_MODEL=qwen/qwen3.8-27b
#WORKER_SA_STRUCTURED=jsonObject
#WORKER_SA_PARALLEL=1
#WORKER_SA_PER_MINUTE=55
# European Union: a hosted worker is not offered there yet, and the region has no address or
# model of its own. Leave WORKER_EU_* unset: its accounts are told so, and no other region
# answers for them. docs/variables.md says what giving it an upstream would take.
# Global: OpenRouter, with no region restriction.
#WORKER_GLOBAL_API_KEY=
#WORKER_GLOBAL_URL=https://openrouter.ai/api/v1
#WORKER_GLOBAL_MODEL=thinkingmachines/inkling-2-mini
#WORKER_GLOBAL_PARALLEL=16
# For the owner's dashboard only: what the worker costs, in US dollars per million tokens.
#WORKER_PRICE_PER_1M_INPUT_TOKENS=
#WORKER_PRICE_PER_1M_OUTPUT_TOKENS=

# --- Optional: rules ---------------------------------------------------------------------------------
#REQUIRE_ACCEPTANCE=signup
#SIGNUP_BLOCKED_COUNTRIES=CU,IR,KP,SY,UA-43,UA-40,UA-14,UA-09
#SIGNUP_BLOCK_EU_UK=1
#USAGE_DATA_RANDOM_IDENTIFIERS_ONLY=1

# --- Optional: the move -----------------------------------------------------------------------------
# Where the emailed sign-in link opens. Set once api.doedesk.com points at this machine.
#CONFIRM_ORIGIN=https://api.doedesk.com
# The key the Cloudflare Worker presents when it hands over contact mail. At least 32 characters.
#MAIL_INGEST_KEY=
# The secret the forwarding Worker presents, for the days it is in front. At least 32 characters.
#FORWARD_SECRET=
# "freeze" stops every write. For the minutes of a move only.
#MAINTENANCE=freeze

# --- Optional: alerts ---------------------------------------------------------------------------------
# Where the machine writes when a unit fails. From an approved sender (signin@doedesk.com if unset).
#ALERT_EMAIL=
#ALERT_FROM=

# --- Optional: tuning (defaults shown) ------------------------------------------------------------------
#DOEDESK_READING_AT_ONCE=4
#DOEDESK_SHUTDOWN_SECONDS=130
#DOEDESK_GEO_MAX_AGE_DAYS=100
#DOEDESK_TRUSTED_PROXIES=
