# Looks the service over every five minutes (server/ops/check.sh). A problem makes this unit
# fail, which starts doedesk-alert@.service and shows in `systemctl --failed`.
[Unit]
Description=DoeDesk Cloud self-check
OnFailure=doedesk-alert@%n.service

[Service]
Type=oneshot
User=doedesk
Group=doedesk
WorkingDirectory=/opt/doedesk/api/current
EnvironmentFile=-/etc/doedesk/check.env
Environment=DOEDESK_DATA=/var/lib/doedesk
Environment=DOEDESK_PORT=8787
ExecStart=/opt/doedesk/api/current/server/ops/check.sh
LogNamespace=doedesk
SyslogIdentifier=doedesk-check

# --- What it may touch ------------------------------------------------------------------------
# The whole system is read-only to it, except its data folder.
ProtectSystem=strict
ReadWritePaths=/var/lib/doedesk
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
UMask=0077

# --- What it may do ---------------------------------------------------------------------------
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete @debug
# Not set: MemoryDenyWriteExecute. The JavaScript engine compiles code as it runs and needs it.
MemoryMax=256M
